# ─── Application ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Database ─────────────────────────────────────────────────
# SQLite (default) - leave DB_TYPE=sqlite
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/chinook.db

# PostgreSQL - set DB_TYPE=postgres and fill below
# DB_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=chinook
# POSTGRES_USER=your_user
# POSTGRES_PASSWORD=your_password

# ─── Vanna / ChromaDB ─────────────────────────────────────────
CHROMA_PATH=./data/chroma_store
VANNA_MODEL=claude-3-5-sonnet-20241022

# ─── Safety ────────────────────────────────────────────────────
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS=1000

# ─── Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
